{
  "rules": {
    ".read": false,
    ".write": false,
    "public": {
      "catalog": {
        ".read": true,
        "$slug": {
          ".write": false
        }
      },
      "activities": {
        "$slug": {
          ".read": "data.child('status').val() === 'active' || data.child('status').val() === 'closed'",
          ".write": false
        }
      }
    },
    "activities": {
      "catalog": {
        ".read": "auth != null && (auth.token.role === 'super' || auth.token.role === 'platform')",
        "$slug": {
          ".read": "auth != null && (auth.token.role === 'super' || auth.token.role === 'platform' || auth.token.managed_activities[$slug] === true)",
          ".write": false
        }
      },
      "$slug": {
        "counters": {
          ".read": "auth != null && (auth.token.role === 'super' || auth.token.role === 'platform' || auth.token.managed_activities[$slug] === true)",
          ".write": false
        },
        "participants": {
          "index": {
            ".read": "auth != null && (auth.token.role === 'super' || auth.token.role === 'platform' || auth.token.managed_activities[$slug] === true)",
            ".write": false
          }
        }
      }
    },
    "admins": {
      "list": {
        ".read": "auth != null && (auth.token.role === 'super' || auth.token.role === 'platform')",
        ".write": false
      }
    },
    "bulkUploads": {
      "$uid": {
        "progress": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": false
        }
      }
    }
  }
}
