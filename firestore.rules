rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "super";
    }

    function isPlatform() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ["platform", "super"];
    }

    function isManagerOf(activitySlug) {
      return signedIn()
        && exists(/databases/$(database)/documents/activities/$(activitySlug)/managers/$(request.auth.uid));
    }

    function canAccessActivity(activitySlug) {
      return isPlatform() || isManagerOf(activitySlug);
    }

    function activityCounterKeys() {
      return ["participantsCount", "certificatesCount", "bulkImportActive"].toSet();
    }

    function activityUpdateAllowed(activitySlug) {
      return canAccessActivity(activitySlug)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(activityCounterKeys());
    }

    function participantCreateKeysOk() {
      return request.resource.data.keys().hasOnly([
        "name", "lookup", "templateKey", "additionalFields",
        "certificateStatus", "createdAt", "updatedAt"
      ])
        && request.resource.data.certificateStatus == "pending";
    }

    function participantUpdateKeysOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["name", "lookup", "templateKey", "additionalFields", "updatedAt"].toSet());
    }

    match /activities/{activitySlug} {
      allow get: if resource.data.status in ["active", "closed"] || canAccessActivity(activitySlug);
      allow list: if isPlatform();
      allow create, delete: if isPlatform();
      allow update: if activityUpdateAllowed(activitySlug);

      match /participants/{participantId} {
        allow read: if canAccessActivity(activitySlug);
        allow create: if canAccessActivity(activitySlug) && participantCreateKeysOk();
        allow update: if canAccessActivity(activitySlug) && participantUpdateKeysOk();
        allow delete: if canAccessActivity(activitySlug);
      }

      match /lookupKeys/{lookupKey} {
        allow read, write: if canAccessActivity(activitySlug);
      }

      match /managers/{uid} {
        allow read: if canAccessActivity(activitySlug);
        allow create, update, delete: if isPlatform();
      }
    }

    match /public/catalog/items/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isPlatform());
      allow create, update, delete: if false;
    }

    match /invites/{inviteId} {
      allow read, write: if false;
    }

    match /bulkUploads/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
