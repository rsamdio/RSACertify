# Public Next.js environment variables
#
# Local: copy this file to `.env.local` (gitignored), add the site key, then restart `npm run dev`.
# Production: the public site key is configured in `netlify.toml` under [build.environment].
# This is a reCAPTCHA v3 site key, not a secret.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
